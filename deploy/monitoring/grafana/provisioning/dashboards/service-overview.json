{
  "title": "AIM - Service Overview",
  "uid": "aim-service-overview",
  "tags": ["aim", "service"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "gRPC QPS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(rpc_server_requests_code_total[5m])) by (method)",
        "legendFormat": "{{ method }}"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "gRPC P99 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(rpc_server_requests_duration_ms_bucket[5m])) by (le, method))",
        "legendFormat": "{{ method }}"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "HTTP QPS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_code_total[5m])) by (path)",
        "legendFormat": "{{ path }}"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "HTTP P99 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_duration_ms_bucket[5m])) by (le, path))",
        "legendFormat": "{{ path }}"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "title": "DB Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "db_open_connections",
        "legendFormat": "open"
      },{
        "expr": "db_in_use_connections",
        "legendFormat": "in_use"
      },{
        "expr": "db_idle_connections",
        "legendFormat": "idle"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "title": "gRPC Error Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(rpc_server_requests_code_total{code!=\"OK\"}[5m])) by (method) / sum(rate(rpc_server_requests_code_total[5m])) by (method)",
        "legendFormat": "{{ method }}"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ]
}
