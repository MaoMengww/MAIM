{
  "title": "AIM - 业务概览",
  "uid": "aim-business-overview",
  "tags": ["aim", "business"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "title": "消息吞吐量",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{
        "expr": "rate(aim_service_messages_sent_total[1m])",
        "legendFormat": "messages/s"
      }]
    },
    {
      "title": "在线用户数",
      "type": "stat",
      "gridPos": {"h": 8, "w": 4, "x": 8, "y": 0},
      "targets": [{
        "expr": "aim_service_ws_connections{service=\"user\"}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      }
    },
    {
      "title": "Bot 请求量",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "expr": "rate(aim_service_bot_requests_total[1m])",
        "legendFormat": "bot: {{bot_id}}"
      }]
    },
    {
      "title": "Bot 响应时间 p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(aim_service_bot_response_seconds_bucket[5m]))",
        "legendFormat": "p95"
      }]
    },
    {
      "title": "HTTP QPS Top 10",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "topk(10, rate(aim_service_http_requests_total[1m]))",
        "legendFormat": "{{method}} {{endpoint}}"
      }]
    },
    {
      "title": "Kafka 消息处理速率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "rate(aim_service_kafka_messages_total[1m])",
        "legendFormat": "{{topic}}"
      }]
    }
  ]
}
