# 开发环境示例。生产环境必须替换凭据与密钥。
# Compose 的服务地址由 docker-compose.yml 提供；以下 loopback 地址供本地进程使用。
POSTGRES_USER=aim
POSTGRES_PASSWORD=aim123
POSTGRES_DB=aim
POSTGRES_DSN_BASE=postgres://aim:aim123@localhost:5432/aim
REDIS_ADDR=localhost:6379
# YAML 列表值必须保留 []；多个地址例如 [localhost:9092,localhost:9093]。
KAFKA_BROKERS=[localhost:9092]
ELASTICSEARCH_ADDRESSES=[http://localhost:9200]

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
OTEL_ENDPOINT=localhost:4317
MINERU_URL=http://localhost:30000

# Generate with: openssl rand -base64 32
JWT_SECRET=changeme
AIM_ENC_KEY=changeme
# 本地直接运行 llm-gateway 时使用 ENC_KEY；Compose 从 AIM_ENC_KEY 注入 ENC_KEY。
ENC_KEY=changeme

USER_SERVICE_ADDR=dns:///localhost:50051
MESSAGE_SERVICE_ADDR=dns:///localhost:50053
FILE_SERVICE_ADDR=dns:///localhost:50054
BOT_PLATFORM_ADDR=dns:///localhost:8085
KNOWLEDGE_BASE_ADDR=dns:///localhost:50057
LLM_GATEWAY_ADDR=dns:///localhost:50056
SIGNALING_SERVICE_ADDR=dns:///localhost:50061
AI_BOT_SERVICE_ADDR=dns:///localhost:50062
WS_GATEWAY_ADDR=dns:///localhost:50060
