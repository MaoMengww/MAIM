# ==== Server ====
SERVER_NAME=aim
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_TIMEOUT=30000

# ==== PostgreSQL ====
DB_DRIVER=postgres
DB_DSN=postgres://aim:aim123@localhost:5432/aim?sslmode=disable
DB_MAX_OPEN_CONN=100
DB_MAX_IDLE_CONN=10
DB_MAX_LIFETIME=3600
POSTGRES_USER=aim
POSTGRES_PASSWORD=aim123
POSTGRES_DB=aim

# ==== Redis ====
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONN=10

# ==== Kafka ====
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=aim-group
KAFKA_VERSION=2.8.0
KAFKA_MAX_RETRY=3
KAFKA_SASL_ENABLE=false

# ==== etcd ====
ETCD_HOSTS=localhost:2379
ETCD_DIAL_TIMEOUT=5
ETCD_TTL=10

# ==== MinIO ====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET=aim
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ==== Elasticsearch ====
ES_ADDRESSES=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ==== JWT ====
# Generate with: openssl rand -base64 32
AIM_ENC_KEY=changeme
JWT_SECRET=changeme
JWT_EXPIRE_SEC=7200
JWT_REFRESH_SEC=604800

# ==== Logging ====
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ==== Neo4j ====
NEO4J_PASSWORD=password123

# ==== Tracing ====
TRACE_ENDPOINT=localhost:4317
TRACE_SAMPLER=always_on
TRACE_RATIO=1.0
